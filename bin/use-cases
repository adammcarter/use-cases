#!/usr/bin/env bash
# `use-cases` — the CLI under its own name. Same runtime as `uc`: the resolver
# beside this script picks it, downloading and checksum-verifying the release
# binary on first use once a release publishes one.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$here/use-cases-runtime" use-cases "$@"
