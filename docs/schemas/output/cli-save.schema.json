{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI output: use-cases save",
  "description": "One use case created, replaced or already as sent (chapter 16).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_version",
    "command",
    "use_case",
    "file",
    "action",
    "changes",
    "warnings",
    "dry_run"
  ],
  "properties": {
    "output_version": {
      "$ref": "cli-common.schema.json#/$defs/outputVersion"
    },
    "command": {
      "const": "save"
    },
    "use_case": {
      "$ref": "../engine/common.schema.json#/$defs/useCaseId"
    },
    "file": {
      "$ref": "../engine/common.schema.json#/$defs/path"
    },
    "action": {
      "enum": [
        "created",
        "added",
        "replaced",
        "unchanged"
      ]
    },
    "changes": {
      "$ref": "cli-common.schema.json#/$defs/changes"
    },
    "warnings": {
      "$ref": "cli-common.schema.json#/$defs/warnings"
    },
    "dry_run": {
      "$ref": "cli-common.schema.json#/$defs/dryRun"
    }
  }
}
