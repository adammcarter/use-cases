#!/usr/bin/env bash
# SessionStart hook for the use-cases.
#
# Emits the trusted bootstrap (bootstrap/use-cases.md) as session-start
# context so an installed agent receives it without having to discover it by
# reading the repo. One script serves three hosts; the JSON shape is chosen from
# the host's env (see critical-info-bootstrap / delivery-shapes):
#   - Claude Code (CLAUDE_PLUGIN_ROOT, not Copilot) -> hookSpecificOutput.additionalContext
#   - Copilot CLI  (COPILOT_CLI)                    -> top-level additionalContext
#   - Codex / other                                 -> hookSpecificOutput.additionalContext

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

bootstrap_content=$(cat "${PLUGIN_ROOT}/bootstrap/use-cases.md" 2>&1 || echo "Error reading use-cases bootstrap")
# Every host's agent is told where uc lives; only Claude can also put it on PATH.
bootstrap_content="${bootstrap_content}

The uc command for this plugin is ${PLUGIN_ROOT}/bin/uc. If \`uc\` is not on PATH, run it by that path."

# Single C-level pass per replacement; far faster than a char loop.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

session_context=$(escape_for_json "$bootstrap_content")

# Claude Code sources $CLAUDE_ENV_FILE before every shell command. Putting the
# plugin's bin/ first on PATH makes `uc` a plain command in the session with
# nothing installed globally. Other hosts leave the variable unset; a file that
# cannot be written is reported, never fatal — the bootstrap below still ships.
#: @use-case:plugin.install.uc_on_path_in_session#hook
if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
  if ! printf 'export PATH="%s/bin:$PATH"\n' "${PLUGIN_ROOT}" >> "${CLAUDE_ENV_FILE}" 2>/dev/null; then
    echo "use-cases: could not write PATH export to CLAUDE_ENV_FILE (${CLAUDE_ENV_FILE}); run uc as ${PLUGIN_ROOT}/bin/uc" >&2
  fi
fi
#: @use-case:end plugin.install.uc_on_path_in_session#hook

# printf (not heredoc) avoids the bash 5.3+ heredoc hang.
if [ -n "${COPILOT_CLI:-}" ]; then
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
else
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
fi

exit 0
