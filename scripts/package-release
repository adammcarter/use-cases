#!/usr/bin/env bash
# Builds the release binaries for this machine and packs them for the release (ADR 039):
#   dist/use-cases-<version>-<platform>.tar.gz          the two programs and their resource bundles
#   dist/use-cases-<version>-<platform>.tar.gz.sha256   its checksum, in `shasum -c` form
# Platforms: macos-universal (arm64 + x86_64), linux-x86_64, linux-arm64.
# Usage: scripts/package-release [tag]    a tag, if given, must equal ProductVersion (v0.1.0 = 0.1.0)
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
root="$(cd "$here/.." && pwd)"
dist="${DIST_DIR:-$root/dist}"

version="$("$here/check-versions" "$@")"

case "$(uname -s)-$(uname -m)" in
  Darwin-*)
    platform="macos-universal"
    flags=(--arch arm64 --arch x86_64)
    ;;
  Linux-x86_64)
    platform="linux-x86_64"
    flags=(--static-swift-stdlib)
    ;;
  Linux-aarch64 | Linux-arm64)
    platform="linux-arm64"
    flags=(--static-swift-stdlib)
    ;;
  *)
    echo "package-release: no release platform for $(uname -s) $(uname -m)" >&2
    exit 1
    ;;
esac

swift build -c release --package-path "$root/UseCases" "${flags[@]}"
bin="$(swift build -c release --package-path "$root/UseCases" "${flags[@]}" --show-bin-path)"

name="use-cases-$version-$platform"
stage="$dist/stage/$name"
rm -rf "$stage"
mkdir -p "$stage"

cp "$bin/use-cases" "$bin/use-cases-transformers" "$stage/"

# Each target with resources builds a bundle that Bundle.module looks for beside the program:
# NAME.bundle on macOS, NAME.resources on Linux. A program copied without them aborts with
# "unable to find bundle named UseCases_UseCasesCore". Take every bundle the build made.
bundles=0
for bundle in "$bin"/*.bundle "$bin"/*.resources; do
  if [[ -d "$bundle" ]]; then
    cp -R "$bundle" "$stage/"
    bundles=$((bundles + 1))
  fi
done

if [[ "$bundles" -eq 0 ]]; then
  echo "package-release: the build made no resource bundles in $bin" >&2
  exit 1
fi

mkdir -p "$dist"
tarball="$dist/$name.tar.gz"
COPYFILE_DISABLE=1 tar -czf "$tarball" -C "$dist/stage" "$name"
rm -rf "$dist/stage"

if command -v sha256sum >/dev/null 2>&1; then
  (cd "$dist" && sha256sum "$name.tar.gz" >"$name.tar.gz.sha256")
else
  (cd "$dist" && shasum -a 256 "$name.tar.gz" >"$name.tar.gz.sha256")
fi

echo "$tarball"
