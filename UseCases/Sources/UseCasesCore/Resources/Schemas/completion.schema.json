{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run Completion Marker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "completion_version",
    "run_id",
    "finished_at",
    "termination",
    "result_count",
    "manifest_sha256",
    "results_sha256",
    "outputs_sha256",
    "reports_sha256"
  ],
  "properties": {
    "completion_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/runId"
    },
    "finished_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "termination": {
      "enum": [
        "completed",
        "interrupted"
      ]
    },
    "result_count": {
      "$ref": "common.schema.json#/$defs/safeNonNegativeInteger"
    },
    "manifest_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "results_sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "outputs_sha256": {
      "description": "SHA-256 of every file under outputs/ (console captures of the commands the core ran), keyed by its path relative to outputs/. Empty for record runs.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!\\./)(?!.*/\\.(?:/|$))(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$(?!\\n)"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    },
    "start_sha256": {
      "description": "SHA-256 of start.json. Present exactly when the run has a start stamp (verify runs).",
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "reports_sha256": {
      "description": "SHA-256 of every file under reports/, keyed by its path relative to reports/ (<id>/...). For a report that was read, the digest is of the bytes as the transformer read them; a reader reports a later change beside the verdicts, never rewriting them. Empty for record runs.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!\\./)(?!.*/\\.(?:/|$))(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.(?:/|$)).+$(?!\\n)"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/sha256"
      }
    }
  }
}
