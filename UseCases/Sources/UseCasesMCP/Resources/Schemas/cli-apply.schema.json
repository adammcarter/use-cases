{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLI output: use-cases apply",
  "description": "A batch of use case changes, applied all or nothing in the order delete, add, update (chapter 16).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_version",
    "command",
    "use_cases",
    "changes",
    "warnings",
    "dry_run"
  ],
  "properties": {
    "output_version": {
      "$ref": "cli-common.schema.json#/$defs/outputVersion"
    },
    "command": {
      "const": "apply"
    },
    "use_cases": {
      "description": "What happened to each use case, in the order applied: every removal, then every addition, then every update.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "use_case",
          "file",
          "action"
        ],
        "properties": {
          "use_case": {
            "$ref": "../engine/common.schema.json#/$defs/useCaseId"
          },
          "file": {
            "$ref": "../engine/common.schema.json#/$defs/path"
          },
          "action": {
            "enum": [
              "removed",
              "created",
              "added",
              "replaced",
              "unchanged"
            ]
          }
        }
      }
    },
    "changes": {
      "$ref": "cli-common.schema.json#/$defs/changes"
    },
    "warnings": {
      "description": "Markers in code that still name a removed use case.",
      "$ref": "cli-common.schema.json#/$defs/warnings"
    },
    "dry_run": {
      "$ref": "cli-common.schema.json#/$defs/dryRun"
    }
  }
}
